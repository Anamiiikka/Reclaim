# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---- Database (Neon Postgres) ----
DATABASE_URL=postgresql://user:password@host.neon.tech/reclaim?sslmode=require

# ---- Razorpay (TEST MODE ONLY) ----
# dashboard.razorpay.com -> Test Mode toggle -> Account & Settings -> API Keys
# A valid test key id starts with "rzp_test_". Never put a live key (rzp_live_) here.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Payment client selection ----
# "simulated" = scriptable failures/timeouts, used for tests and the failure demo.
# "razorpay"  = real test-mode API calls.
PAYMENT_CLIENT=simulated

# ---- Determinism ----
# Every generated dataset and evaluation run is reproducible from this seed.
RECLAIM_SEED=20260831

# ---- Server ----
PORT=3000
NODE_ENV=development
